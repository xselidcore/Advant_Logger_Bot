#: main.py:51
msgid "⚠ All your data was cleared because of disconnecting"
msgstr "⚠ Все данные были удалены из-за отключения бота от аккаунта"

#: main.py:67
msgid ""
"<tg-emoji emoji-id=\"5343584360182349563\">➕</tg-emoji> <b>Бот успешно подключён!</b>\n"
"Привет, <b><a href='tg://user?id={user_id}'>{name}</a></b>!\n"
"\n"
"Теперь я буду отслеживать изменения и удаления сообщений в твоих переписках."
msgstr ""
"<tg-emoji emoji-id=\"5343584360182349563\">➕</tg-emoji> <b>Бот успешно подключён!</b>\n"
"Привет, <b><a href='tg://user?id={user_id}'>{name}</a></b>!\n"
"\n"
"Теперь я буду отслеживать изменения и удаления сообщений в твоих переписках."

#: handlers/deleting.py:42
msgid ""
"<tg-emoji emoji-id=\"5235927882466876283\">🗑</tg-emoji> <b>Deletion  ·  "
"<a href='{user_link}'>{name}</a></b>\n"
"\n"
"<blockquote expandable>{msg}</blockquote>"
msgstr ""
"<tg-emoji emoji-id=\"5235927882466876283\">🗑</tg-emoji> <b>Удалено  ·  "
"<a href='{user_link}'>{name}</a></b>\n"
"\n"
"<blockquote expandable>{msg}</blockquote>"

#: handlers/deleting.py:81 handlers/deleting.py:154
