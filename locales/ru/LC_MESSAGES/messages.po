#: handlers/deleting.py:117
msgid "<b>Voice message can't be sent because of your privacy settings!</b>"
msgstr "<b>Голосовое сообщение не может быть отправлено из-за настроек приватности!</b>"

#: handlers/edit.py:56 handlers/edit.py:92
msgid ""
"<tg-emoji emoji-id=\"5301173701323028420\">✏️</tg-emoji> <b>Edit  ·  <a href='{user_link}'>{name}</a></b>"
"\n\n<i>Was</i>"
"<blockquote expandable>{old_msg}</blockquote>"
"<i>Now</i>"
"<blockquote expandable>{new_msg}</blockquote>"
msgstr ""
"<tg-emoji emoji-id=\"5301173701323028420\">✏️</tg-emoji> <b>Изменено  ·  <a href='{user_link}'>{name}</a></b>"
"\n\n<i>Было</i>"
"<blockquote expandable>{old_msg}</blockquote>"
"<i>Стало</i>"
"<blockquote expandable>{new_msg}</blockquote>"
#: handlers/receive.py:32
msgid ""
"An error has occurred! Please add the bot to your profile again!\n"
"\n"
"<i>via</i> @{bot_username}"
msgstr ""
"Произошла ошибка! Пожалуйста, добавь бота в профиль заново!\n"
"\n"
